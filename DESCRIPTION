Package: curatedCRCData
Type: Package
Title: Colorectal Cancer Gene Expression Analysis
Version: 2.45.3
Date: 2026-10-03
Authors@R: c(
    person("Princy", "Parsana", role = "aut"),
    person("Markus", "Riester", role = "aut"),
